{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "widgets",
  "description": "Small pop-out widget windows: they only read saved data, so no network or file access.",
  "windows": ["widget-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top"
  ]
}
